{
    // Ctrl+Shift+B (Cmd+Shift+B on Mac) runs the default build task: build and run.
    // On Windows these use mingw32-make from raylib's w64devkit.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run",
            "type": "shell",
            "command": "make run",
            "windows": { "command": "C:/raylib/w64devkit/bin/mingw32-make.exe run" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "make",
            "windows": { "command": "C:/raylib/w64devkit/bin/mingw32-make.exe" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run the tests",
            "type": "shell",
            "command": "make test",
            "windows": { "command": "C:/raylib/w64devkit/bin/mingw32-make.exe test" },
            "group": "test",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "windows": { "command": "C:/raylib/w64devkit/bin/mingw32-make.exe clean" },
            "problemMatcher": []
        }
    ]
}
